{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://regesta.io/schema/v0.1/procedure.schema.json",
  "title": "Regesta procedure document",
  "description": "One EU procedure (COD, DEA or RPS) as a continuous record across Commission, Parliament and Council. Every node and edge carries provenance, sources, retrieval time and licence. This is the form of one file in the data repository and of the full procedure object in the API. Personal data never appear in this document; roles in the procedure are a link to the API ('people').",
  "type": "object",
  "required": [
    "schema_version", "id", "slug", "type", "title", "status", "institution_leads",
    "provenance", "sources", "license", "valid_from",
    "identifiers", "steps", "documents", "edges", "gaps", "people", "attribution"
  ],
  "properties": {
    "$schema": { "const": "https://regesta.io/schema/v0.1/procedure.schema.json" },
    "schema_version": { "const": "0.1.0" },
    "id": { "$ref": "#/$defs/canonical_id" },
    "slug": { "type": "string", "pattern": "^([0-9]{4}-[0-9]{4}-(cod|dea|rps)|c-[0-9]{4}-[1-9][0-9]*)$" },
    "type": { "enum": ["COD", "DEA", "RPS"] },
    "title": { "type": "string", "minLength": 1, "description": "Official English title as given by the source." },
    "status": { "enum": ["ongoing", "completed", "withdrawn", "rejected"] },
    "institution_leads": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commission_dg", "ep_committees"],
      "properties": {
        "commission_dg": { "type": ["string", "null"], "pattern": "^[A-Z]{2,8}$", "description": "Lead Directorate-General, e.g. SANTE; null if not (yet) known." },
        "ep_committees": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]{3}$" },
          "description": "Lead EP committee(s), e.g. [\"SANT\"]. Two entries for joint committee procedures (EP Rules of Procedure, joint committee meetings). Empty if the source names none."
        }
      }
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "sources": { "$ref": "#/$defs/sources" },
    "license": { "$ref": "#/$defs/graph_license" },
    "modified": { "type": "boolean" },
    "valid_from": { "$ref": "#/$defs/run_id" },
    "valid_to": { "$ref": "#/$defs/run_id_or_null" },
    "identifiers": { "type": "array", "items": { "$ref": "#/$defs/identifier" } },
    "steps": { "type": "array", "items": { "$ref": "#/$defs/step" } },
    "documents": { "type": "array", "items": { "$ref": "#/$defs/document" } },
    "consultations": { "type": "array", "items": { "$ref": "#/$defs/consultation" } },
    "legal_acts": { "type": "array", "items": { "$ref": "#/$defs/legal_act" } },
    "deadlines": { "type": "array", "items": { "$ref": "#/$defs/deadline" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "gaps": { "type": "array", "items": { "$ref": "#/$defs/gap" } },
    "people": {
      "description": "Roles in the procedure (rapporteur with group) are served only by the Regesta API from servers in the EU, never stored in this document (build rule G1).",
      "type": "string",
      "pattern": "^https://regesta\\.io/v1/procedures/([0-9]{4}-[0-9]{4}-(cod|dea|rps)|c-[0-9]{4}-[1-9][0-9]*)/people$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "time"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "time": { "type": "string", "format": "date-time" }
      }
    },
    "attribution": { "$ref": "#/$defs/attribution" }
  },
  "additionalProperties": false,
  "allOf": [
    { "if": { "properties": { "type": { "const": "COD" } } }, "then": { "properties": { "id": { "pattern": "\\(COD\\)$" }, "slug": { "pattern": "-cod$" } } } },
    { "if": { "properties": { "type": { "const": "RPS" } } }, "then": { "properties": { "id": { "pattern": "\\(RPS\\)$" }, "slug": { "pattern": "-rps$" } } } },
    { "if": { "properties": { "type": { "const": "DEA" } } }, "then": { "properties": { "id": { "pattern": "(^C\\(|\\(DEA\\)$)" }, "slug": { "pattern": "(^c-|-dea$)" } } } }
  ],
  "$defs": {
    "canonical_id": {
      "type": "string",
      "pattern": "^([0-9]{4}/[0-9]{4}\\((COD|DEA|RPS)\\)|C\\([0-9]{4}\\)[1-9][0-9]*)$",
      "description": "COD and RPS: interinstitutional number in EP spelling. DEA: Commission C number; EP number only while no C number is assigned (provisional)."
    },
    "run_id": {
      "type": "string",
      "pattern": "^(run-[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z|manual-[0-9]{4}-[0-9]{2}-[0-9]{2})$",
      "description": "Run in which the statement was first observed. 'manual-' marks hand-captured reference data."
    },
    "run_id_or_null": { "anyOf": [{ "$ref": "#/$defs/run_id" }, { "type": "null" }] },
    "graph_license": {
      "const": "CC-BY-4.0",
      "description": "Every node and edge of the graph is CC BY 4.0. Voting data (ODbL) are never part of this document (build rule B2-1)."
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "url", "retrieved", "license", "legal_basis"],
      "properties": {
        "source": {
          "enum": ["ep_api", "cellar", "eurlex_meta", "hys", "regdel", "council_pdf"],
          "description": "HowTheyVote ('htv') is not a permitted source in this document; it belongs only to the separate ODbL voting database (build rule B2-1)."
        },
        "url": { "type": "string", "format": "uri" },
        "ref": { "type": "string", "minLength": 1, "description": "Identifier of the object at the source." },
        "retrieved": { "type": "string", "format": "date-time" },
        "license": { "enum": ["CC-BY-4.0", "CC0-1.0", "LicenseRef-EC-Decision-2011-833", "LicenseRef-Council-Decision-2017-1842"] },
        "legal_basis": { "type": "string", "minLength": 1 }
      }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["official", "derived", "missing"] },
        "rule": { "type": "string", "pattern": "^R([1-9]|1[01])$" },
        "rule_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "quality": { "enum": ["exact", "high", "medium"], "description": "Matches of quality 'low' are never published as an edge; they appear as missing with reason match_below_threshold." },
        "score": { "type": "number", "minimum": 0, "maximum": 1 },
        "evidence": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "reason": { "$ref": "#/$defs/gap_reason_on_procedure" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "const": "derived" } } }, "then": { "required": ["rule", "rule_version", "quality", "evidence"], "not": { "required": ["reason"] } } },
        { "if": { "properties": { "status": { "const": "missing" } } }, "then": { "required": ["reason"], "not": { "anyOf": [{ "required": ["rule"] }, { "required": ["quality"] }] } } },
        { "if": { "properties": { "status": { "const": "official" } } }, "then": { "not": { "anyOf": [{ "required": ["rule"] }, { "required": ["quality"] }, { "required": ["reason"] }] } } }
      ]
    },
    "gap_reason_on_procedure": {
      "allOf": [{ "$ref": "gap-reason.schema.json" }, { "not": { "const": "source_unavailable" } }],
      "description": "A source outage is recorded only in source health, never on a procedure."
    },
    "statement": {
      "type": "object",
      "required": ["provenance", "sources", "license", "valid_from"],
      "properties": {
        "provenance": { "$ref": "#/$defs/provenance" },
        "sources": { "$ref": "#/$defs/sources" },
        "license": { "$ref": "#/$defs/graph_license" },
        "modified": { "type": "boolean", "description": "true if Berth changed or derived the content (CC BY requires changes to be indicated)." },
        "valid_from": { "$ref": "#/$defs/run_id" },
        "valid_to": { "$ref": "#/$defs/run_id_or_null" },
        "supersedes": { "type": "string", "minLength": 1 }
      },
      "if": { "properties": { "provenance": { "properties": { "status": { "enum": ["official", "derived"] } } } } },
      "then": { "properties": { "sources": { "minItems": 1 } } }
    },
    "identifier": {
      "allOf": [{ "$ref": "#/$defs/statement" }, { "$ref": "identifier.schema.json" }],
      "unevaluatedProperties": false
    },
    "institution": { "enum": ["commission", "parliament", "council"] },
    "step": {
      "allOf": [
        { "$ref": "#/$defs/statement" },
        {
          "type": "object",
          "required": ["id", "institution", "kind", "date", "date_precision"],
          "properties": {
            "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:()/ -]*$" },
            "institution": { "$ref": "#/$defs/institution" },
            "kind": { "$ref": "step-kind.schema.json" },
            "source_kind": { "type": "string", "minLength": 1, "description": "Activity type exactly as given by the source (e.g. EP had_activity_type), mapped 1:1 to kind by step-kind.schema.json." },
            "date": { "type": "string", "format": "date" },
            "date_precision": { "enum": ["day", "month", "year"] },
            "documents": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        {
          "description": "Build rule B2-2: status, result and date of plenary votes come only from the EP API or Cellar, never from HowTheyVote.",
          "if": { "properties": { "kind": { "enum": ["plenary_vote", "objection_vote", "plenary_amend", "plenary_amend_proposal", "plenary_adopt_position", "plenary_refer_committee_interinstitutional_negotiations", "plenary_endorse_committee_interinstitutional_negotiations"] } }, "required": ["kind"] },
          "then": { "properties": { "sources": { "items": { "properties": { "source": { "enum": ["ep_api", "cellar"] } } } } } }
        }
      ],
      "unevaluatedProperties": false
    },
    "document": {
      "allOf": [
        { "$ref": "#/$defs/statement" },
        {
          "type": "object",
          "required": ["id", "institution", "doc_type", "access"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "description": "Canonical document identifier, e.g. 'ST 10713/26', 'COM(2025)102', 'A-10-2025-0272'." },
            "institution": { "$ref": "#/$defs/institution" },
            "doc_type": { "type": "string", "minLength": 1 },
            "date": { "type": "string", "format": "date" },
            "url": { "type": "string", "format": "uri" },
            "access": { "enum": ["public", "limite", "not_public"] }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "consultation": {
      "allOf": [
        { "$ref": "#/$defs/statement" },
        {
          "type": "object",
          "required": ["hys_initiative", "phase", "url"],
          "properties": {
            "hys_initiative": { "type": "string", "pattern": "^[1-9][0-9]*$" },
            "phase": { "enum": ["call_for_evidence", "public_consultation", "draft_for_feedback"] },
            "start": { "type": "string", "format": "date" },
            "end": { "type": "string", "format": "date" },
            "feedback_count": { "type": "integer", "minimum": 0, "description": "Number of feedback items only. Names, organisations and texts of 'Have your say' feedback never appear." },
            "url": { "type": "string", "format": "uri" }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "legal_act": {
      "allOf": [
        { "$ref": "#/$defs/statement" },
        {
          "type": "object",
          "required": ["celex"],
          "properties": {
            "celex": { "type": "string", "pattern": "^[0-9CE][0-9]{4}[A-Z]{1,2}[0-9]{4}[0-9A-Z()_-]*$" },
            "eli": { "type": "string", "pattern": "^http://data\\.europa\\.eu/eli/.+$" },
            "oj_ref": { "type": "string", "minLength": 1 },
            "dates": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "entry_into_force": { "type": "string", "format": "date" },
                "application": { "type": "string", "format": "date" },
                "transposition_deadline": { "type": "string", "format": "date" }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "deadline": {
      "allOf": [
        { "$ref": "#/$defs/statement" },
        {
          "type": "object",
          "required": ["id", "kind", "date"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "kind": { "enum": ["consultation_end", "entry_into_force", "application", "transposition", "scrutiny_end", "scheduled_trilogue", "scheduled_vote"] },
            "date": { "type": "string", "format": "date" }
          }
        },
        {
          "description": "R11: the end of the scrutiny period is always derived, quality at most medium.",
          "if": { "properties": { "kind": { "const": "scrutiny_end" } }, "required": ["kind"] },
          "then": { "properties": { "provenance": { "properties": { "status": { "const": "derived" }, "rule": { "const": "R11" } } } } }
        }
      ],
      "unevaluatedProperties": false
    },
    "edge": {
      "allOf": [
        { "$ref": "#/$defs/statement" },
        {
          "type": "object",
          "required": ["id", "edge", "from", "to"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "edge": {
              "enum": ["has_step", "has_document", "has_consultation", "produces", "delegated_under", "same_as", "implements", "role_in", "amends", "has_deadline"],
              "description": "vote_on (rule R8) exists only in the ODbL voting database votes/vote_links (build rule B2-1)."
            },
            "from": { "type": "string", "minLength": 1 },
            "to": { "type": "string", "minLength": 1 }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "institution", "kind", "reason", "since"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "institution": { "$ref": "#/$defs/institution" },
        "kind": { "type": "string", "minLength": 1, "description": "What is missing, e.g. a step kind such as 'council_adoption' or 'council_vote'." },
        "reason": { "$ref": "#/$defs/gap_reason_on_procedure" },
        "since": { "type": "string", "format": "date" },
        "note": { "type": "string" },
        "sources": { "$ref": "#/$defs/sources" },
        "valid_from": { "$ref": "#/$defs/run_id" },
        "valid_to": { "$ref": "#/$defs/run_id_or_null" }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_de", "text_en", "license", "license_url", "licenses_page", "disclaimer_url", "official"],
      "properties": {
        "text_de": { "type": "string", "minLength": 1 },
        "text_en": { "type": "string", "minLength": 1 },
        "license": { "const": "CC-BY-4.0" },
        "license_url": { "const": "https://creativecommons.org/licenses/by/4.0/" },
        "licenses_page": { "const": "https://regesta.io/licences" },
        "disclaimer_url": { "const": "https://regesta.io/licences#disclaimer" },
        "official": { "const": false }
      }
    }
  }
}
